# Local development values only. Copy this file to .env before starting MySQL.
MYSQL_DATABASE=pinglix
PINGLIX_DB_USERNAME=pinglix
PINGLIX_DB_PASSWORD=replace-with-your-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password
MYSQL_PORT=3306

# Optional values for docker-compose.prod.example.yml.
# Replace every placeholder before using the production-style example.
# BACKEND_PORT=8080
# FRONTEND_PORT=5174
# PINGLIX_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# PINGLIX_CORS_ALLOWED_ORIGINS=http://localhost:5174
# PINGLIX_COOKIE_SECURE=true
# PINGLIX_COOKIE_SAME_SITE=Lax
# VITE_API_BASE_URL=http://localhost:8080
# VITE_WS_URL=ws://localhost:8080/ws
